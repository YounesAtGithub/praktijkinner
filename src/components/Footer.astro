---
import Container from './Container.astro';
---

<footer class="py-10">
  <Container class="border-t border-taupe/20 pt-8">
    <div class="grid gap-8 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <p class="font-serif text-lg tracking-[0.14em] uppercase text-ink">
          Praktijk Inner
        </p>
        <p class="mt-3 text-sm leading-relaxed text-ink/60">
          Praktijk voor Psychologische behandeling, Systeemtherapie en Relatietherapie.
        </p>
      </div>

      <div>
  <h2 class="text-sm font-medium text-ink">Contactgegevens</h2>

  <div class="mt-3 space-y-3 text-sm leading-relaxed text-ink/60">
    <div class="grid grid-cols-[1.25rem_1fr] gap-3">
      <span aria-hidden="true">📍</span>
      <span>Maliestraat 3, 3581 SH Utrecht</span>
    </div>

    <div class="grid grid-cols-[1.25rem_1fr] gap-3">
      <span aria-hidden="true">📞</span>
      <div>
        <p class="text-xs uppercase tracking-wide text-ink/45">Telefoon 1</p>
        <a href="tel:+31617895194" class="hover:text-ink">06-17895194</a>
      </div>
    </div>

    <div class="grid grid-cols-[1.25rem_1fr] gap-3">
      <span aria-hidden="true">📞</span>
      <div>
        <p class="text-xs uppercase tracking-wide text-ink/45">Telefoon 2</p>
        <a href="tel:+31657719037" class="hover:text-ink">06-57719037</a>
      </div>
    </div>

    <div class="grid grid-cols-[1.25rem_1fr] gap-3">
      <span aria-hidden="true">✉️</span>
      <a href="mailto:info@praktijkinner.nl" class="hover:text-ink">
        info@praktijkinner.nl
      </a>
    </div>

    <div class="grid grid-cols-[1.25rem_1fr] gap-3">
      <span aria-hidden="true">🏢</span>
      <span>KvK: 89035356</span>
    </div>
  </div>
</div>

      <div>
        <h2 class="text-sm font-medium text-ink">Informatie</h2>

        <nav class="mt-4 grid gap-2 text-sm text-ink/60">
          <a href="/privacy" class="hover:text-ink">Privacyreglement</a>
          <a href="/kwaliteitsstatuut" class="hover:text-ink">Kwaliteitsstatuut</a>
          <a href="/klachten" class="hover:text-ink">Klachten- en geschillencommissie</a>
        </nav>
      </div>

    </div>

    <div class="mt-8 border-t border-taupe/20 pt-4">
      <p class="text-sm text-ink/50">
        © {new Date().getFullYear()} Praktijk Inner. Alle rechten voorbehouden.
      </p>
    </div>
  </Container>
</footer>